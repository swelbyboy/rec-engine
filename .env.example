ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Supabase — required for the Live PoC (poc/live-matchmaking branch): candidate
# data, the mind schema read for the Mind Live/Fixed comparison and per-role
# rubric lookup (mind.rubric_configs, injected into the fine-rerank prompt —
# see mind_rubric_store.py), and the in-process Bullhorn job-submissions check
# all go through this. Same project Mind's own .env points at; ask for the
# service-role key, not the anon key (PostgREST needs it to read the mind
# schema via Accept-Profile). Missing/unreachable is non-fatal for the rubric
# lookup specifically — it degrades to the pipeline's generic prompt.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Bullhorn REST API credentials (OAuth2 username/password grant) — same values
# Mind uses (mind/.env), needed only for the "Download CV" candidate-card
# feature. Without these, candidate cards still show the Bullhorn ID as plain
# text, just no working CV download.
BULLHORN_CLIENT_ID=your_bullhorn_client_id
BULLHORN_CLIENT_SECRET=your_bullhorn_client_secret
BULLHORN_API_USERNAME=your_bullhorn_api_username
BULLHORN_API_PASSWORD=your_bullhorn_api_password
# Optional — defaults to https://auth-emea.bullhornstaffing.com if unset.
BULLHORN_AUTH_URL=https://auth-emea.bullhornstaffing.com
